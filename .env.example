MADAR_API_HOST=127.0.0.1
MADAR_API_PORT=7101
MADAR_DATA_DIR=./server/data
MADAR_SECURE_COOKIE=false
MADAR_ALLOWED_ORIGINS=http://localhost:7100,http://127.0.0.1:7100
# Optional: generate a separate random 32-byte key as 64 hexadecimal characters.
# MADAR_TOKEN_KEY=replace_with_your_random_64_hex_characters
FACEBOOK_GRAPH_VERSION=v23.0
FACEBOOK_SCOPES=pages_show_list,pages_read_engagement,pages_messaging,pages_manage_metadata
# Generate a separate random verification secret for Meta webhooks.
# FACEBOOK_VERIFY_TOKEN=replace_with_a_random_webhook_secret
# Primary OpenAI-compatible provider. Set the key in Coolify as a runtime secret only.
ZAKI_GATEWAY_URL=https://glm.erv.zakiai.io/v1
ZAKI_GATEWAY_MODEL=auto/best-chat
ZAKI_GATEWAY_API_KEY=replace_with_your_gateway_key
# Optional comma-separated additional public HTTPS gateway hostnames.
# ZAKI_GATEWAY_ALLOWED_HOSTS=glm.erv.zakiai.io
